        0.3,
        0.9
      ],
      "log": true
    },
    "env1.decay": {
      "range": [
        0.01,
        0.04
      ],
      "log": true
    },
    "env1.sustain": 0
  },
  "routes": [
    {
      "source": "env1",
      "dest": "oscillator3.volume",
      "amount": [
        40,
        70
