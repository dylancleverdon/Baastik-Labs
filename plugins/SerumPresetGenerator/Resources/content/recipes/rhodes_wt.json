{
  "name": "Rhodes-style EP (RMrk1 table)",
  "knobs": {
    "osc.count": {
      "choose": {
        "1": 3,
        "2": 1
      }
    },
    "osc0.wavetable": "rhodes_mk1",
    "osc0.unison": {
      "choose": {
        "1": 1,
        "2": 1,
        "3": 2
      }
    },
    "osc0.detune": [
      0.004,
      0.012
    ],
    "osc1.wavetable": "default",
    "osc1.frame": "sine",
    "osc1.volume": [
      0.15,
      0.35
    ],
    "noise.on": 0.6,
    "noise.type": "White",
    "noise.volume": [
      0.001,
      0.02
    ],
    "lfo0.shape": {
      "choose": {
        "triangle": 1,
        "sine": 1
      }
    },
    "lfo0.sync": 0.5,
    "lfo0.syncRate": {
      "choose": {
        "1/4": 1,
        "1/2": 1
      }
    },
    "lfo0.rateHz": {
      "range": [
        0.3,
        1.5
      ],
      "log": true
    },
    "lfo0.mode": "Free",
    "fx.FXDistortion": 0.6,
    "fx.FXDistortion.kParamMode": "kSoftClip",
    "fx.FXDistortion.kParamDrive": [
      15,
      35
    ],
    "fx.FXDistortion.kParamWet": [
      50,
      80
    ],
    "amp.release": {
      "range": [
        0.3,
        0.5
      ],
      "log": true
    }
  },
  "routes": [
    {
      "source": "lfo0",
      "dest": "oscillator0.detune",
      "amount": [
        20,
        45
      ]
    }
  ]
}
