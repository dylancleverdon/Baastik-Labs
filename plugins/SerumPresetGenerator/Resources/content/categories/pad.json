{
  "name": "Pad",
  "family": "synth",
  "knobs": {
    "global.mono": 0.02,
    "global.poly": {
      "choose": {
        "8": 2,
        "12": 1,
        "16": 1
      }
    },
    "global.porta": 0.05,
    "osc.count": {
      "choose": {
        "2": 3,
        "3": 3
      }
    },
    "osc.unison": {
      "choose": {
        "3": 1,
        "4": 2,
        "5": 2,
        "7": 2,
        "9": 1
      }
    },
    "osc.detune": [
      0.08,
      0.35
    ],
    "osc.width": [
      70,
      100
    ],
    "amp.attack": {
      "range": [
        0.3,
        2.5
      ],
      "log": true
    },
    "amp.decay": {
      "range": [
        1.0,
        4.0
      ],
      "log": true
    },
    "amp.sustain": [
      0.6,
      1
    ],
    "amp.release": {
      "range": [
        1.0,
        4.0
      ],
      "log": true
    },
    "filter.on": 0.6,
    "filter.cutoff": [
      0.3,
      0.8
    ],
    "filter.type": {
      "choose": {
        "MgL12": 2,
        "L12": 2,
        "MgL24": 1,
        "L24": 1,
        "B12": 1,
        "FormantONE": 0.5
      }
    },
    "lfo.count": {
      "choose": {
        "1": 3,
        "2": 3,
        "3": 1
      }
    },
    "lfo.sync": 0.4,
    "lfo.rateHz": {
      "range": [
        0.05,
        1.0
      ],
      "log": true
    },
    "lfo.mode": {
      "choose": {
        "Free": 3,
        "Retrig": 1
      }
    },
    "lfo.dest": {
      "choose": {
        "oscillator*.table_position": 5,
        "filter*.cutoff": 3,
        "oscillator*.pan": 2,
        "oscillator*.detune": 1
      }
    },
    "lfo.amount": [
      -40,
      40
    ],
    "noise.on": 0.2,
    "noise.volume": [
      0.02,
      0.12
    ],
    "fx.FXReverb": 0.95,
    "fx.FXReverb.kParamWet": [
      25,
      55
    ],
    "fx.FXReverb.kParamSize": [
      50,
      95
    ],
    "fx.FXChorus": 0.5,
    "fx.FXDelay": 0.4,
    "fx.FXDistortion": 0.1,
    "recipe": {
      "choose": {
        "none": 3,
        "evolving_pad": 2,
        "warm_analog_pad": 2,
        "choir_pad": 1,
        "dreamy_sines": 1
      }
    },
    "sanity.minSustain": 0.5,
    "osc.octave": {
      "choose": {
        "0": 5,
        "1": 1,
        "-1": 1
      }
    }
  }
}
