  "perCategory": {
    "lead": {
      "recipe": {
        "choose": {
          "supersaw": 2,
          "sync_lead": 2,
          "none": 1
        }
      },
      "osc.octave": {
        "choose": {
          "0": 1,
          "1": 2
        }
