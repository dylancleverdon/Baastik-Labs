<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Serum Preset Generator @VERSION@</title>
    <organization>com.baastiklabs</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="Serum Preset Generator">
        <pkg-ref id="com.baastiklabs.serumpresetgenerator"/>
    </choice>
    <pkg-ref id="com.baastiklabs.serumpresetgenerator" version="@VERSION@" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
